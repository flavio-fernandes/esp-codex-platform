# /etc/workbench/agent.env -- read by wb-agent-shell, wb-camera and wb-pico-flash.
# Installed from workbench/config/agent.env.example only if absent; edit in place.

# Camera. Prefer the stable by-id path of YOUR camera:
#   ls -l /dev/v4l/by-id/
WB_CAMERA_DEVICE=/dev/v4l/by-id/usb-REPLACE_WITH_YOUR_CAMERA-video-index0
WB_CAMERA_WIDTH=1280
WB_CAMERA_HEIGHT=720
WB_CAMERA_SKIP=10
# auto, or a manual exposure_time_absolute value. A lit LED matrix blows out
# under auto exposure; a short manual exposure keeps the pixels legible.
WB_CAMERA_EXPOSURE=auto

# Which slots the restricted agent user may touch, space separated.
# RP2040/RP2350 boards (flash-pico, pico-save, pico-info):
WB_AGENT_PICO_SLOTS="SLOT1"
# ESP boards (flash-esp, reset). Empty = ESP flashing disabled for agents.
WB_AGENT_ESP_SLOTS=""

# Largest firmware accepted on stdin (bytes).
WB_AGENT_MAX_FW_BYTES=16777216
