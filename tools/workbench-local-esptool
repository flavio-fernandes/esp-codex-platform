#!/usr/bin/env bash
set -euo pipefail

RAW_SLOT="${1:-SLOT1}"
SLOT_EXPLICIT=false

if [[ "${RAW_SLOT}" =~ ^[Ss][Ll][Oo][Tt][0-9]+$ ]]; then
  SLOT="$(printf '%s' "${RAW_SLOT}" | tr '[:lower:]' '[:upper:]')"
  SLOT_EXPLICIT=true
  shift || true
else
  SLOT="SLOT1"
fi

if [ "$#" -eq 0 ]; then
  set -- chip-id
fi

REENUMERATE_WAIT="${ESPWB_LOCAL_REENUMERATE_WAIT:-12}"
REENUMERATE_INTERVAL="${ESPWB_LOCAL_REENUMERATE_INTERVAL:-0.5}"
POST_ESPTOOL_SETTLE="${ESPWB_LOCAL_POST_ESPTOOL_SETTLE:-8}"
GPIO_RESET="${ESPWB_LOCAL_GPIO_RESET:-0}"
FORCE_BOOTLOADER="${ESPWB_LOCAL_FORCE_BOOTLOADER:-0}"
BOOTLOADER_WAIT="${ESPWB_LOCAL_BOOTLOADER_WAIT:-12}"
GPIO_BOOT="${ESPWB_LOCAL_GPIO_BOOT:-18}"
GPIO_EN="${ESPWB_LOCAL_GPIO_EN:-17}"
ESPTOOL_SUCCEEDED=false

LOCK_DIR="/tmp/espwb-local-esptool-${UID}"
mkdir -p "${LOCK_DIR}"
chmod 700 "${LOCK_DIR}" 2>/dev/null || true

LOCK="${LOCK_DIR}/lock"
exec 9>"${LOCK}"

if ! flock -n 9; then
  echo "ERROR: another ESP workbench operation is already running" >&2
  exit 65
fi

single_serial_fallback() {
  mapfile -t serials < <(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || true)

  case "${#serials[@]}" in
    0)
      echo "ERROR: no serial devices found" >&2
      exit 66
      ;;
    1)
      printf '%s\n' "${serials[0]}"
      ;;
    *)
      echo "ERROR: multiple serial devices exist and ${SLOT} could not be resolved safely" >&2
      printf '  %s\n' "${serials[@]}" >&2
      echo "Refusing to guess. Check: curl -fsS http://127.0.0.1:8080/api/devices | python3 -m json.tool" >&2
      exit 69
      ;;
  esac
}

lookup_slot() {
  local json
  json="$(curl -fsS --max-time 3 http://127.0.0.1:8080/api/devices 2>/dev/null || true)"

  if [ -z "${json}" ]; then
    echo "NO_API"
    return 0
  fi

  python3 -c '
import json
import sys

slot = sys.argv[1].upper()
data = json.load(sys.stdin)

for item in data.get("slots", []):
    if str(item.get("label", "")).upper() == slot:
        devnode = item.get("devnode")
        if devnode:
            print("DEV " + devnode)
        else:
            print("ABSENT")
        sys.exit(0)

print("MISSING")
' "${SLOT}" <<<"${json}"
}

udev_property() {
  local devnode="$1"
  local property="$2"

  udevadm info -q property -n "${devnode}" 2>/dev/null |
    sed -n "s/^${property}=//p" |
    head -n 1
}

devpath_parent() {
  local devnode="$1"
  local devpath

  devpath="$(udev_property "${devnode}" DEVPATH)"
  if [ -z "${devpath}" ]; then
    return 0
  fi

  printf '%s\n' "${devpath%/tty/*}"
}

usb_device_from_parent() {
  local parent="$1"
  local usb_device

  usb_device="${parent##*/}"
  usb_device="${usb_device%%:*}"
  if [ -n "${usb_device}" ] && [ -e "/sys/bus/usb/devices/${usb_device}" ]; then
    printf '%s\n' "${usb_device}"
  fi
}

capture_device_identity() {
  local devnode="$1"
  local id_path parent

  id_path="$(udev_property "${devnode}" ID_PATH)"
  parent="$(devpath_parent "${devnode}")"

  printf '%s\n%s\n' "${id_path}" "${parent}"
}

matching_serial_devices() {
  local original_id_path="$1"
  local original_parent="$2"
  local candidate candidate_id_path candidate_parent

  for candidate in /dev/ttyACM* /dev/ttyUSB*; do
    [ -e "${candidate}" ] || continue

    candidate_id_path="$(udev_property "${candidate}" ID_PATH)"
    if [ -n "${original_id_path}" ] && [ "${candidate_id_path}" = "${original_id_path}" ]; then
      printf '%s\n' "${candidate}"
      continue
    fi

    candidate_parent="$(devpath_parent "${candidate}")"
    if [ -n "${original_parent}" ] && [ "${candidate_parent}" = "${original_parent}" ]; then
      printf '%s\n' "${candidate}"
    fi
  done
}

matching_bootloader_devices() {
  local original_id_path="$1"
  local original_parent="$2"
  local candidate vendor model

  while IFS= read -r candidate; do
    vendor="$(udev_property "${candidate}" ID_VENDOR_ID | tr '[:upper:]' '[:lower:]')"
    model="$(udev_property "${candidate}" ID_MODEL_ID | tr '[:upper:]' '[:lower:]')"
    if [ "${vendor}" = "303a" ] && [ "${model}" = "0002" ]; then
      printf '%s\n' "${candidate}"
    fi
  done < <(matching_serial_devices "${original_id_path}" "${original_parent}")
}

resolve_after_portal_stop() {
  local original_dev="$1"
  local original_id_path="$2"
  local original_parent="$3"
  local deadline now
  local -a matches

  deadline="$(python3 -c 'import sys, time; print(time.monotonic() + float(sys.argv[1]))' "${REENUMERATE_WAIT}")"

  while :; do
    if [ -n "${original_dev}" ] && [ -e "${original_dev}" ]; then
      printf '%s\n' "${original_dev}"
      return 0
    fi

    mapfile -t matches < <(matching_serial_devices "${original_id_path}" "${original_parent}")
    case "${#matches[@]}" in
      0)
        ;;
      1)
        printf '%s\n' "${matches[0]}"
        return 0
        ;;
      *)
        echo "ERROR: multiple serial devices match ${SLOT} topology after portal stop" >&2
        printf '  %s\n' "${matches[@]}" >&2
        return 69
        ;;
    esac

    now="$(python3 -c 'import time; print(time.monotonic())')"
    if python3 -c 'import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)' "${now}" "${deadline}"; then
      break
    fi
    sleep "${REENUMERATE_INTERVAL}"
  done

  return 67
}

wait_for_rom_bootloader() {
  local original_id_path="$1"
  local original_parent="$2"
  local deadline now
  local -a matches

  deadline="$(python3 -c 'import sys, time; print(time.monotonic() + float(sys.argv[1]))' "${BOOTLOADER_WAIT}")"

  while :; do
    mapfile -t matches < <(matching_bootloader_devices "${original_id_path}" "${original_parent}")
    case "${#matches[@]}" in
      0)
        ;;
      1)
        printf '%s\n' "${matches[0]}"
        return 0
        ;;
      *)
        echo "ERROR: multiple ESP32-S2 ROM bootloader devices match ${SLOT} topology" >&2
        printf '  %s\n' "${matches[@]}" >&2
        return 69
        ;;
    esac

    now="$(python3 -c 'import time; print(time.monotonic())')"
    if python3 -c 'import sys; sys.exit(0 if float(sys.argv[1]) >= float(sys.argv[2]) else 1)' "${now}" "${deadline}"; then
      break
    fi
    sleep "${REENUMERATE_INTERVAL}"
  done

  return 67
}

wait_for_portal() {
  local ok=false

  for i in $(seq 1 30); do
    if curl -fsS http://127.0.0.1:8080/api/info >/dev/null 2>&1; then
      ok=true
      break
    fi
    sleep 1
  done

  if [ "${ok}" != true ]; then
    echo "ERROR: rfc2217-portal did not become ready after restart" >&2
    sudo systemctl --no-pager --full status rfc2217-portal >&2 || true
    sudo journalctl -u rfc2217-portal -n 80 --no-pager >&2 || true
    return 68
  fi
}

usb_unbind() {
  local usb_device="$1"

  if [ -z "${usb_device}" ]; then
    return 0
  fi

  echo "== unbinding USB device ${usb_device} =="
  printf '%s' "${usb_device}" | sudo tee /sys/bus/usb/drivers/usb/unbind >/dev/null
}

usb_rebind() {
  local usb_device="$1"

  if [ -z "${usb_device}" ]; then
    return 0
  fi

  echo "== rebinding USB device ${usb_device} =="
  printf '%s' "${usb_device}" | sudo tee /sys/bus/usb/drivers/usb/bind >/dev/null
}

force_rom_bootloader() {
  if [ "${FORCE_BOOTLOADER}" != "1" ]; then
    return 0
  fi

  echo "== forcing ESP32-S2 ROM bootloader with BOOT GPIO${GPIO_BOOT} and EN GPIO${GPIO_EN} =="
  sudo python3 - "${GPIO_BOOT}" "${GPIO_EN}" <<'PY'
import sys
import time

import gpiod

boot = int(sys.argv[1])
en = int(sys.argv[2])
chip = gpiod.Chip("/dev/gpiochip0")
requests = []

try:
    boot_req = chip.request_lines(
        consumer="espwb-local-esptool-boot",
        config={
            boot: gpiod.LineSettings(
                direction=gpiod.line.Direction.OUTPUT,
                output_value=gpiod.line.Value.INACTIVE,
            )
        },
    )
    requests.append(boot_req)

    en_req = chip.request_lines(
        consumer="espwb-local-esptool-boot",
        config={
            en: gpiod.LineSettings(
                direction=gpiod.line.Direction.OUTPUT,
                output_value=gpiod.line.Value.ACTIVE,
            )
        },
    )
    requests.append(en_req)
    time.sleep(0.05)
    en_req.set_value(en, gpiod.line.Value.INACTIVE)
    time.sleep(0.15)
    en_req.set_value(en, gpiod.line.Value.ACTIVE)
    time.sleep(0.5)
finally:
    for request in requests:
        request.release()

release_req = chip.request_lines(
    consumer="espwb-local-esptool-boot-release",
    config={
        boot: gpiod.LineSettings(
            direction=gpiod.line.Direction.INPUT,
            bias=gpiod.line.Bias.PULL_UP,
        )
    },
)
time.sleep(0.05)
release_req.release()
PY
}

release_boot_and_pulse_en() {
  if [ "${GPIO_RESET}" != "1" ]; then
    return 0
  fi

  echo "== releasing BOOT GPIO${GPIO_BOOT} and pulsing EN GPIO${GPIO_EN} =="
  sudo python3 - "${GPIO_BOOT}" "${GPIO_EN}" <<'PY'
import sys
import time

import gpiod

boot = int(sys.argv[1])
en = int(sys.argv[2])
chip = gpiod.Chip("/dev/gpiochip0")
requests = []

try:
    boot_req = chip.request_lines(
        consumer="espwb-local-esptool",
        config={
            boot: gpiod.LineSettings(
                direction=gpiod.line.Direction.INPUT,
                bias=gpiod.line.Bias.PULL_UP,
            )
        },
    )
    requests.append(boot_req)

    en_req = chip.request_lines(
        consumer="espwb-local-esptool",
        config={
            en: gpiod.LineSettings(
                direction=gpiod.line.Direction.OUTPUT,
                output_value=gpiod.line.Value.ACTIVE,
            )
        },
    )
    requests.append(en_req)
    time.sleep(0.05)
    en_req.set_value(en, gpiod.line.Value.INACTIVE)
    time.sleep(0.15)
    en_req.set_value(en, gpiod.line.Value.ACTIVE)
    time.sleep(0.25)
finally:
    for request in requests:
        request.release()
PY
}

cleanup() {
  rc=$?
  trap - EXIT INT TERM
  set +e

  if [ "${ESPTOOL_SUCCEEDED}" = true ]; then
    release_boot_and_pulse_en
  fi

  if [ "${ESPTOOL_SUCCEEDED}" = true ] && [ "${POST_ESPTOOL_SETTLE}" != "0" ]; then
    echo "== waiting ${POST_ESPTOOL_SETTLE}s for native USB to settle before restarting portal =="
    sleep "${POST_ESPTOOL_SETTLE}"
  fi

  echo "== starting rfc2217-portal again =="
  sudo systemctl start rfc2217-portal
  start_rc=$?

  if [ "${start_rc}" -ne 0 ]; then
    echo "ERROR: failed to start rfc2217-portal" >&2
    sudo systemctl --no-pager --full status rfc2217-portal >&2 || true
    sudo journalctl -u rfc2217-portal -n 80 --no-pager >&2 || true
    exit "${start_rc}"
  fi

  wait_for_portal
  wait_rc=$?

  if [ "${wait_rc}" -ne 0 ]; then
    exit "${wait_rc}"
  fi

  exit "${rc}"
}

slot_result="$(lookup_slot || true)"

case "${slot_result}" in
  "DEV "*)
    DEV="${slot_result#DEV }"
    ;;
  "ABSENT")
    echo "ERROR: ${SLOT} is configured but no board is present there" >&2
    exit 66
    ;;
  "MISSING")
    echo "ERROR: ${SLOT} is not known by the workbench portal" >&2
    exit 66
    ;;
  "NO_API")
    if [ "${SLOT_EXPLICIT}" = true ]; then
      echo "WARNING: workbench API unavailable, using serial fallback only if exactly one device exists" >&2
    fi
    DEV="$(single_serial_fallback)"
    ;;
  *)
    echo "ERROR: unexpected slot lookup result: ${slot_result}" >&2
    exit 70
    ;;
esac

if [ -z "${DEV}" ] || [ ! -e "${DEV}" ]; then
  echo "ERROR: resolved device ${DEV:-empty} does not exist" >&2
  exit 67
fi

mapfile -t device_identity < <(capture_device_identity "${DEV}")
ORIGINAL_ID_PATH="${device_identity[0]:-}"
ORIGINAL_DEVPATH_PARENT="${device_identity[1]:-}"
ORIGINAL_USB_DEVICE="$(usb_device_from_parent "${ORIGINAL_DEVPATH_PARENT}")"

trap cleanup EXIT INT TERM

echo "== using ${SLOT} device ${DEV} on workbench =="
if [ -n "${ORIGINAL_ID_PATH}" ]; then
  echo "== ${SLOT} USB topology: ${ORIGINAL_ID_PATH} =="
fi
echo "== stopping rfc2217-portal temporarily =="
sudo systemctl stop rfc2217-portal
sleep 0.5

if [ "${FORCE_BOOTLOADER}" = "1" ]; then
  usb_unbind "${ORIGINAL_USB_DEVICE}"
  force_rom_bootloader
  usb_rebind "${ORIGINAL_USB_DEVICE}"
else
  if ! RESOLVED_DEV="$(resolve_after_portal_stop "${DEV}" "${ORIGINAL_ID_PATH}" "${ORIGINAL_DEVPATH_PARENT}")"; then
    echo "ERROR: ${DEV} did not reappear after stopping portal" >&2
    echo "No matching serial device appeared on the original USB topology within ${REENUMERATE_WAIT}s." >&2
    exit 67
  fi

  if [ "${RESOLVED_DEV}" != "${DEV}" ]; then
    echo "== ${SLOT} re-enumerated from ${DEV} to ${RESOLVED_DEV} =="
    DEV="${RESOLVED_DEV}"
  fi
fi

if [ "${FORCE_BOOTLOADER}" = "1" ]; then
  if ! RESOLVED_DEV="$(wait_for_rom_bootloader "${ORIGINAL_ID_PATH}" "${ORIGINAL_DEVPATH_PARENT}")"; then
    echo "ERROR: ${SLOT} did not enter ESP32-S2 ROM bootloader within ${BOOTLOADER_WAIT}s" >&2
    exit 67
  fi

  if [ "${RESOLVED_DEV}" != "${DEV}" ]; then
    echo "== ${SLOT} ROM bootloader is ${RESOLVED_DEV} =="
    DEV="${RESOLVED_DEV}"
  fi
fi

HAS_BEFORE=false
HAS_AFTER=false

for arg in "$@"; do
  case "${arg}" in
    --before)
      HAS_BEFORE=true
      ;;
    --after)
      HAS_AFTER=true
      ;;
  esac
done

run_esptool_with_retries() {
  local attempts="${ESPWB_LOCAL_ESPTOOL_ATTEMPTS:-3}"
  local attempt before_mode rc resolved_dev

  before_mode="default-reset"
  if [ "${FORCE_BOOTLOADER}" = "1" ]; then
    before_mode="no-reset"
  fi

  for attempt in $(seq 1 "${attempts}"); do
    local -a opts=(--port "${DEV}")

    if [ "${HAS_BEFORE}" = false ]; then
      opts+=(--before "${before_mode}")
    fi

    if [ "${HAS_AFTER}" = false ]; then
      opts+=(--after hard-reset)
    fi

    if [ "${attempt}" -gt 1 ]; then
      echo "== retrying esptool on ${DEV} (attempt ${attempt}/${attempts}, before=${before_mode}) =="
    fi

    set +e
    python3 -m esptool "${opts[@]}" "$@"
    rc=$?
    set -e

    if [ "${rc}" -eq 0 ]; then
      ESPTOOL_SUCCEEDED=true
      return 0
    fi

    if [ "${attempt}" -ge "${attempts}" ]; then
      return "${rc}"
    fi

    echo "WARNING: esptool failed with exit code ${rc}; waiting for ${SLOT} USB re-enumeration before retry" >&2
    if ! resolved_dev="$(resolve_after_portal_stop "${DEV}" "${ORIGINAL_ID_PATH}" "${ORIGINAL_DEVPATH_PARENT}")"; then
      echo "ERROR: ${SLOT} device did not reappear for esptool retry" >&2
      return "${rc}"
    fi

    if [ "${resolved_dev}" != "${DEV}" ]; then
      echo "== ${SLOT} re-enumerated from ${DEV} to ${resolved_dev} =="
      DEV="${resolved_dev}"
    fi

    if [ "${HAS_BEFORE}" = false ]; then
      before_mode="no-reset"
    fi

    sleep 1
  done
}

run_esptool_with_retries "$@"
