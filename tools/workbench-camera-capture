#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/lib/workbench-env
source "$SCRIPT_DIR/lib/workbench-env"
load_bench_env
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  printf 'Usage: tools/workbench-camera-capture [output.jpg]\nCapture the bench camera via SSH; server exposure is the default.\n'
  exit 0
fi
[[ $# -le 1 ]] || exit 2
out="${1:-artifacts/bench-camera-$(date -u +%Y%m%dT%H%M%SZ).jpg}"
bench_camera_options
bench_download "$out" snap "${BENCH_CAMERA_OPTIONS[@]}"
printf '%s\n' "$out"
