#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/lib/workbench-env
source "$SCRIPT_DIR/lib/workbench-env"
load_bench_env
usage() {
  printf 'Usage: tools/espwb-esptool chip-id|flash-id\n       tools/espwb-esptool write-flash 0xOFFSET IMAGE\n       tools/espwb-esptool read-flash 0x0 SIZE OUTPUT\nOnly one merged image; backup reads begin at zero. Remote exit codes are preserved.\n'
}
[[ $# -gt 0 ]] || { usage >&2; exit 2; }
[[ "$1" != --help && "$1" != -h ]] || { usage; exit 0; }
bench_slot
case "$1" in
  chip-id|flash-id)
    [[ $# == 1 ]] || { usage >&2; exit 2; }
    bench_ssh flash-esp "$BENCH_SLOT" "$1" ;;
  write-flash)
    [[ $# == 3 && "$2" =~ ^0x[0-9a-fA-F]+$ && -f "$3" && -r "$3" && -s "$3" ]] || { usage >&2; exit 2; }
    bench_ssh flash-esp "$BENCH_SLOT" write-flash "$2" < "$3" ;;
  read-flash)
    [[ $# == 4 && "$2" =~ ^(0|0x0+)$ && "$3" =~ ^(ALL|[0-9]+|0x[0-9a-fA-F]+)$ ]] || { usage >&2; exit 2; }
    bench_download "$4" esp-save "$BENCH_SLOT" "$3" ;;
  *) usage >&2; exit 2 ;;
esac
