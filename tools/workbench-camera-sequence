#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/lib/workbench-env
source "$SCRIPT_DIR/lib/workbench-env"
load_bench_env
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  printf 'Usage: tools/workbench-camera-sequence [count (1..60)] [interval (0..600)] [output.tar]\nRemote timed capture; output is a tar archive of JPEGs.\n'
  exit 0
fi
[[ $# -le 3 ]] || exit 2
count="${1:-4}"; interval="${2:-3}"
[[ "$count" =~ ^[0-9]{1,2}$ && "$interval" =~ ^[0-9]{1,3}$ ]] || exit 2
((10#$count >= 1 && 10#$count <= 60 && 10#$interval <= 600)) || exit 2
out="${3:-artifacts/bench-camera-$(date -u +%Y%m%dT%H%M%SZ).tar}"
bench_camera_options
bench_download "$out" seq "$count" "$interval" "${BENCH_CAMERA_OPTIONS[@]}"
printf '%s\n' "$out"
