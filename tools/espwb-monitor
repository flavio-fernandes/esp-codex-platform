#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/lib/workbench-env
source "$SCRIPT_DIR/lib/workbench-env"
load_bench_env
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  printf 'Usage: tools/espwb-monitor [seconds (1..600)]\nStreams serial-follow JSON; no reset on exit. Default: 300 seconds.\n'
  exit 0
fi
[[ $# -le 1 ]] || exit 2
bench_slot
seconds="${1:-${BENCH_MONITOR_MAX_TIME:-300}}"
# Legacy zero meant unlimited; the server deliberately bounds each follow.
[[ "$seconds" != 0 ]] || seconds=600
[[ "$seconds" =~ ^[0-9]{1,3}$ ]] && ((10#$seconds >= 1 && 10#$seconds <= 600)) || exit 2
bench_ssh serial-follow "$BENCH_SLOT" "$seconds"
