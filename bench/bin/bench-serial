#!/usr/bin/env python3
"""Run the serial owner from a source checkout or the installed bench library."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
sys.path.append("/opt/bench/lib")
from benchlib.serialowner import main

if __name__ == "__main__":
    sys.exit(main())
