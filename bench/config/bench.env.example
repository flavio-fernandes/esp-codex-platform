# Literal KEY=VALUE only; this file is not shell code.
# Replace this placeholder with the camera's stable device path.
BENCH_CAMERA_DEVICE=/dev/v4l/by-id/<camera-device>
# Choose exposure for the installed camera and scene.
BENCH_CAMERA_EXPOSURE=auto
# Power switching is opt-in and still subject to USB safety guards.
BENCH_POWER_CYCLE=0