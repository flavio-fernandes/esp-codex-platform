# Copy to config/bench.env (ignored). Trusted local shell configuration.
# The SSH alias must use a restricted key for wbagent and verified known_hosts.
BENCH_AGENT=bench-agent
BENCH_SLOT=SLOT1
BENCH_ALLOW_NON_SLOT1=0
BENCH_SSH_CONNECT_TIMEOUT=10
BENCH_SSH_SERVER_ALIVE_INTERVAL=5
BENCH_SSH_SERVER_ALIVE_COUNT_MAX=2
BENCH_MONITOR_MAX_TIME=300
BENCH_STATIC_ONLY=0
# Optional: BENCH_SSH_KEY, BENCH_SSH_CONFIG, BENCH_KNOWN_HOSTS.
# Camera defaults are the server's; optional per-call overrides:
# BENCH_CAMERA_EXPOSURE=auto
# BENCH_CAMERA_WIDTH=1280
# BENCH_CAMERA_HEIGHT=720
# BENCH_CAMERA_SKIP=10
